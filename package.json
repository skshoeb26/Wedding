{
  "name": "wedding-invitation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side generator for animated, self-contained wedding invitation websites.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "start": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "test:dist": "node tools/build-site.mjs && EDITOR_DIR=dist node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
